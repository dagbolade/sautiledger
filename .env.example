# Copy to .env and fill in. .env is gitignored — never commit the key.
SAHARA_API_KEY=
# SAUTI_MODE=cloud | offline   (default: cloud if key set, else offline)
# SAUTI_PACK=pcm-yo-NG
# SAUTI_DB=data/ledger.db
# SAUTI_ASR=sync | async       (async: upload + poll, for flaky links)
# Agent fallback model: auto = local Ollama if running, else grammar-only.
# "hosted" sends unparseable utterance TEXT to a hosted model (logged as
# egress) — explicit opt-in only, and needs HF_TOKEN.
# SAUTI_AGENT=auto | local | hosted | none
# HF_TOKEN=
