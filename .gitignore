# secrets — the API key never gets committed
.env

# local data — the ledger never leaves this device
data/
recordings/
*.wav
*.webm
*.mp4
*.m4a
*.opus
*.ogg
bench/corpus/*/raw/

# benchmark: fetched datasets + raw outputs are never committed
# (AfriSwitch is CC BY-NC-SA — fetched at run time, not redistributed;
#  only REPORT.md is tracked)
bench/corpus/afriswitch-sample/
bench/results/*
!bench/results/REPORT.md

# python
.venv/
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/

# editors
.idea/
.vscode/
